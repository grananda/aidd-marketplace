{
  "description": "Registro de actividad AIDD/AISDD: anota en docs/aidd-activity.md que skill se ejecuta, que ficheros toca la IA y cuanto dura cada turno, para que `aiba metrics` pueda calcular KPIs. Opt-in: solo registra si ese fichero ya existe en el proyecto.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/aidd-activity-hook.sh\"",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/aidd-activity-hook.sh\"",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/hooks/aidd-activity-hook.sh\"",
            "async": true
          }
        ]
      }
    ]
  }
}
